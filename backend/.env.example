# 复制本文件为 .env，并填入真实配置

# ===== 运行环境 =====
# development / production；production 会强制校验 JWT_SECRET 不是默认值
APP_ENV=development

# ===== DeepSeek 对话模型 =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 向量库后端 =====
# sqlite：本地内嵌向量库（默认，无需 Docker，数据在 backend/vector.db）
# milvus：独立向量服务（需先启动 docker-compose 里的 milvus）
VECTOR_BACKEND=sqlite
VECTOR_DB_PATH=./vector.db

# ===== Milvus 向量库（VECTOR_BACKEND=milvus 时生效）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 多租户改造后集合新增 tenant_id 分区键，改用新集合名（旧集合需 drop 或忽略）
MILVUS_COLLECTION=kb_documents_v3

# ===== 本地 Embedding 模型 =====
# 中文向量模型，首次运行会自动从 HuggingFace 下载（约 400MB）
# 国内可设环境变量 HF_ENDPOINT=https://hf-mirror.com 加速
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DEVICE=cpu

# ===== 检索参数 =====
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# 向量召回数量（交给 reranker 精排的候选数）
RETRIEVE_TOP_K=20

# ===== 混合检索（向量 + BM25 关键词，用 RRF 融合）=====
# false 则回退为纯向量召回
HYBRID_RETRIEVAL_ENABLED=true
# BM25 关键词通路召回的候选数量
BM25_TOP_K=20
# BM25 语料最多取多少块参与打分（演示规模）
BM25_CORPUS_LIMIT=1000
# RRF 融合参数：score = Σ 1 / (RRF_K + rank)
RRF_K=60

# ===== Rerank 策略 =====
# none 不精排 / always 总是精排 / conditional 候选数达到阈值才精排
RERANK_STRATEGY=always
RERANK_MIN_CANDIDATES=8
RERANKER_MODEL=BAAI/bge-reranker-base

# ===== 检索缓存（Redis，不可用时自动失效）=====
RETRIEVAL_CACHE_ENABLED=true

# ===== 数据库 =====
# 默认 SQLite，零依赖即可跑起来；切 PostgreSQL 用下面这行
# postgresql+psycopg://kb:kb@localhost:5432/kb
DATABASE_URL=sqlite:///./kb.db
# 启动时自动把库结构迁移到最新（等价 alembic upgrade head）
RUN_MIGRATIONS_ON_START=true

# ===== 日志 =====
LOG_LEVEL=INFO
# true 输出 JSON 行日志（便于采集）；false 输出可读文本
LOG_JSON=true

# ===== Redis（查询缓存 / 限流；连不上会自动降级到进程内实现）=====
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ===== 限流（令牌桶）=====
RATE_LIMIT_ENABLED=true
# 桶容量（突发上限）与每秒补充令牌数
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=0.5

# ===== 鉴权 =====
# 生产环境务必改成随机长字符串（APP_ENV=production 时不改会启动失败）
JWT_SECRET=kb-jwt-secret-please-change-in-production-0123456789
JWT_EXPIRE_HOURS=24

# ===== 订单超时自动取消 =====
# 待付款订单超过该分钟数自动取消并回补库存
ORDER_PENDING_TIMEOUT_MINUTES=30
ORDER_EXPIRE_SWEEP_ENABLED=true
ORDER_EXPIRE_SWEEP_INTERVAL_SECONDS=60

# ===== 大模型调用重试 =====
# 网络抖动 / 限流 / 5xx 时的最大尝试次数（指数退避，仅非流式调用）
LLM_MAX_RETRIES=2
# 连接超时（秒）：外网不可达时尽快降级为知识库摘录
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=60

# ===== 方向 D：自适应检索路由 + 语义缓存 =====
# 按问题复杂度选择 none / vector / hybrid_rerank
ADAPTIVE_RETRIEVAL_ENABLED=true
# 排障用：强制策略（none/vector/hybrid/hybrid_rerank），留空表示自动
RETRIEVAL_FORCE_STRATEGY=
SEMANTIC_CACHE_ENABLED=true
# 相似度阈值：0.76 配合意图归一校验
SEMANTIC_CACHE_THRESHOLD=0.76
SEMANTIC_CACHE_TTL_SECONDS=3600

# ===== 演示数据种子 =====
# 启动时写入演示店铺 / 商品 / 顾客历史订单
SEED_DEMO_DATA=true
# 启动时把 samples/ 下的客服知识文档导入平台知识库（需要可加载 Embedding 模型）
SEED_KNOWLEDGE=true
# 知识文档目录（相对项目根目录）
SAMPLES_DIR=samples

# ===== Agent 参数 =====
# 工具调用循环的最大轮数
AGENT_MAX_STEPS=5
